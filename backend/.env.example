# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
DB_PATH=./database.sqlite

# JWT
JWT_SECRET=mrfix_secret_key_mude_em_producao
JWT_EXPIRES_IN=7d

# Token de serviço (validade em minutos)
